# ================================================
# Quantoo — Environment Configuration
# ================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/quantoo_dev?schema=public"

# Application URL (used for email links, redirects)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Quantum Daily"

# Authentication
# IMPORTANT: Generate a strong secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET="dev-secret-change-in-production-minimum-32-chars"

# Email Configuration (Development: use Mailpit or similar)
# For local development, emails are logged to console if SMTP is not configured.
EMAIL_FROM="noreply@quantoo.dev"
# SMTP_HOST="localhost"
# SMTP_PORT="1025"
# SMTP_USER=""
# SMTP_PASSWORD=""

# Logging
LOG_LEVEL="info"

# ================================================
# Quantum Execution Sandbox (Phase 4)
# ================================================
# Execution isolation mode:
#   docker         - run submissions in the quantoo/quantum-runtime container (production)
#   host-fallback  - run via host Python with a restricted environment (LOCAL DEVELOPMENT ONLY;
#                    must be enabled explicitly; weaker isolation than the container sandbox)
#   disabled       - refuse all executions
QUANTOO_SANDBOX_MODE="docker"

# Resource limits (values are clamped to safe bounds; see docs/architecture/execution.md)
EXEC_MAX_QUBITS="8"
EXEC_MAX_DEPTH="200"
EXEC_MAX_OPERATIONS="1000"
EXEC_MAX_SHOTS="4096"
EXEC_TIMEOUT_MS="15000"
EXEC_MEMORY_MB="512"
EXEC_MAX_OUTPUT_BYTES="16000"
EXEC_MAX_SOURCE_BYTES="50000"

# Future phases (do not configure yet)
# QUANTUM_PROVIDER=""
# QUANTUM_API_KEY=""