// Quantum Daily — Database Schema
// Phase 3: Problem system, content taxonomy, learning architecture, progress tracking.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// Enums
// ========================================

enum ProblemDifficulty {
  BEGINNER
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum ProblemStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  ATTEMPTED
  SOLVED
}

enum ActivityType {
  PROBLEM_ATTEMPT
  PROBLEM_SOLVED
  PROBLEM_VIEWED
  PROJECT_CREATED
  PROJECT_UPDATED
  DAILY_CHALLENGE_ATTEMPT
  LEARNING_TOPIC_STARTED
  LEARNING_TOPIC_COMPLETED
}

enum TestSpecType {
  STRUCTURAL
  FUNCTIONAL
  STATE
  DISTRIBUTION
  UNITARY
  OBSERVABLE
  ENTANGLEMENT
  STATISTICAL
  RESOURCE
}

enum ProblemRelationType {
  PREREQUISITE
  RELATED
  NEXT
  SAME_CONCEPT
}

enum SubmissionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT
  RESOURCE_LIMIT
}

enum SecurityEventType {
  SIGNUP_SUCCESS
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  EMAIL_VERIFIED
  VERIFICATION_REQUESTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_SUCCESS
  PASSWORD_CHANGED
  SESSION_REVOKED
}

// ========================================
// Authentication
// ========================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile                   Profile?
  sessions                  Session[]
  verificationTokens        EmailVerificationToken[]
  passwordResetTokens       PasswordResetToken[]
  problemProgress           UserProblemProgress[]
  activities                UserActivity[]
  dailyChallengeSubmissions DailyChallengeSubmission[]
  securityEvents            SecurityEvent[]
  learningProgress          UserLearningProgress[]
  submissions               Submission[]
  problemDrafts             ProblemDraft[]
  semanticBaselines         SemanticBaseline[]
  semanticComparisons       SemanticComparison[]
  semanticReproductions     SemanticReproduction[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model SecurityEvent {
  id        String            @id @default(uuid())
  userId    String?
  type      SecurityEventType
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime          @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type])
  @@map("security_events")
}

// ========================================
// Profile
// ========================================

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique
  username    String?  @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ========================================
// Concepts (reusable quantum concept taxonomy)
// ========================================

model Concept {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  category    String? // e.g. "foundations", "gates", "algorithms", "error-correction"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problems       ProblemConcept[]
  learningTopics LearningTopicConcept[]

  @@index([category])
  @@index([slug])
  @@map("concepts")
}

// ========================================
// Tags (reusable problem tags)
// ========================================

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  problems ProblemTag[]

  @@index([slug])
  @@map("tags")
}

// ========================================
// Learning Topics
// ========================================

model LearningTopic {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  category    String? // e.g. "fundamentals", "gates", "circuits", "algorithms"
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  concepts     LearningTopicConcept[]
  problems     LearningTopicProblem[]
  userProgress UserLearningProgress[]

  @@index([slug])
  @@index([category, sortOrder])
  @@map("learning_topics")
}

model LearningTopicConcept {
  id        String @id @default(uuid())
  topicId   String
  conceptId String
  sortOrder Int    @default(0)

  topic   LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  concept Concept       @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([topicId, conceptId])
  @@map("learning_topic_concepts")
}

model LearningTopicProblem {
  id        String @id @default(uuid())
  topicId   String
  problemId String
  sortOrder Int    @default(0)

  topic   LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  problem Problem       @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([topicId, problemId])
  @@map("learning_topic_problems")
}

// ========================================
// Problems
// ========================================

model Problem {
  id                  String            @id @default(uuid())
  slug                String            @unique
  title               String
  shortDescription    String
  description         String            @db.Text
  difficulty          ProblemDifficulty
  status              ProblemStatus     @default(DRAFT)
  estimatedMinutes    Int?
  prerequisites       String?           @db.Text // Text list of prerequisite descriptions
  learningObjectives  String?           @db.Text // JSON array of objectives
  hints               Json? // Structured hints array: [{content, order}]
  solutionExplanation Json? // Structured explanation: {approach, whyItWorks, concepts, commonMistakes, furtherLearning}
  testSpecification   Json? // Future Judge contract: structured test cases
  requirements        Json? // Problem requirements: {qubits, gates, depth, etc.}
  expectedOutcome     Json? // What a correct solution achieves
  starterCode         String?           @db.Text // Versioned starter code for the workspace
  publishedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  tags             ProblemTag[]
  concepts         ProblemConcept[]
  versions         ProblemVersion[]
  progress         UserProblemProgress[]
  activity         UserActivity[]
  learningTopics   LearningTopicProblem[]
  relatedFrom      ProblemRelation[]      @relation("fromProblem")
  relatedTo        ProblemRelation[]      @relation("toProblem")
  submissions      Submission[]
  drafts           ProblemDraft[]
  SemanticBaseline SemanticBaseline[]

  @@index([difficulty])
  @@index([status])
  @@index([status, difficulty])
  @@index([publishedAt])
  @@map("problems")
}

model ProblemTag {
  id        String @id @default(uuid())
  problemId String
  tagId     String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([problemId, tagId])
  @@map("problem_tags")
}

model ProblemConcept {
  id        String @id @default(uuid())
  problemId String
  conceptId String

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([problemId, conceptId])
  @@map("problem_concepts")
}

model ProblemRelation {
  id     String              @id @default(uuid())
  fromId String
  toId   String
  type   ProblemRelationType

  fromProblem Problem @relation("fromProblem", fields: [fromId], references: [id], onDelete: Cascade)
  toProblem   Problem @relation("toProblem", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([fromId])
  @@index([toId])
  @@map("problem_relations")
}

model ProblemVersion {
  id        String   @id @default(uuid())
  problemId String
  version   Int
  content   Json
  changelog String?
  createdAt DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, version])
  @@map("problem_versions")
}

// ========================================
// Submissions & Execution Artifacts (Phase 4)
// ========================================

/// A user's code submission for a problem. Each execution creates one row.
/// The execution artifact (circuit metadata, counts, probabilities, stdout, etc.)
/// is stored in `executionResult` as structured JSON so future phases
/// (debugger, analytics, portfolio) can consume it without a migration.
model Submission {
  id              String           @id @default(uuid())
  userId          String
  problemId       String
  sourceCode      String           @db.Text
  language        String           @default("python")
  status          SubmissionStatus @default(PENDING)
  errorCode       String? // Structured error category, e.g. SYNTAX_ERROR, TIMEOUT
  errorMessage    String? // Safe, user-facing error message (no stack traces)
  passed          Boolean? // Judge verdict (null = not yet judged)
  judgeResult     Json? // Full JudgeResult {passed, checks, failures, summary}
  executionResult Json? // Execution artifact {circuit, counts, probabilities, ...}
  durationMs      Int?
  createdAt       DateTime         @default(now())
  completedAt     DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem           Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  semanticBaselines SemanticBaseline[]

  @@index([userId, createdAt])
  @@index([problemId, createdAt])
  @@index([userId, problemId, createdAt])
  @@index([status])
  @@map("submissions")
}

/// A user's saved in-progress code for a problem (code persistence).
/// This is a DRAFT — never treated as a verified submission.
model ProblemDraft {
  id         String   @id @default(uuid())
  userId     String
  problemId  String
  sourceCode String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, updatedAt])
  @@map("problem_drafts")
}

// ========================================
// Quantum Semantic Observatory (Phase 6)
// ========================================

/// A baseline execution a user designates for later comparisons.
/// One baseline per user per problem; re-designating replaces it.
model SemanticBaseline {
  id           String   @id @default(uuid())
  userId       String
  problemId    String
  submissionId String
  policyName   String   @default("statistical-default")
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([problemId])
  @@index([submissionId])
  @@map("semantic_baselines")
}

/// Persisted evidence of a comparison between two executions.
/// Comparison verdicts are always recomputed server-side; this table
/// stores the structured result for history and evidence links.
model SemanticComparison {
  id            String   @id @default(uuid())
  userId        String
  recordAId     String // submission id of execution A
  recordBId     String // submission id of execution B
  policyName    String
  overallStatus String
  result        Json // full SemanticComparison payload
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([recordAId])
  @@index([recordBId])
  @@map("semantic_comparisons")
}

/// Records of reproduction attempts (original submission -> new run).
model SemanticReproduction {
  id                       String   @id @default(uuid())
  userId                   String
  originalSubmissionId     String
  reproductionSubmissionId String
  policyName               String
  overallStatus            String
  result                   Json // full ReproductionReport payload
  createdAt                DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([originalSubmissionId])
  @@map("semantic_reproductions")
}

model UserProblemProgress {
  id            String         @id @default(uuid())
  userId        String
  problemId     String
  status        ProgressStatus @default(NOT_STARTED)
  attempts      Int            @default(0)
  bestTimeMs    Int?
  lastAttemptAt DateTime?
  startedAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, status])
  @@index([problemId, status])
  @@map("user_problem_progress")
}

model UserLearningProgress {
  id          String         @id @default(uuid())
  userId      String
  topicId     String
  status      ProgressStatus @default(NOT_STARTED)
  progressPct Int            @default(0) // 0-100
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic LearningTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@map("user_learning_progress")
}

model UserActivity {
  id        String       @id @default(uuid())
  userId    String
  type      ActivityType
  problemId String?
  metadata  Json?
  createdAt DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([problemId])
  @@map("user_activities")
}

// ========================================
// Daily Challenges
// ========================================

model DailyChallenge {
  id        String   @id @default(uuid())
  date      DateTime @unique @db.Date
  problemId String
  createdAt DateTime @default(now())

  submissions DailyChallengeSubmission[]

  @@map("daily_challenges")
}

model DailyChallengeSubmission {
  id          String   @id @default(uuid())
  userId      String
  challengeId String
  solved      Boolean  @default(false)
  solveTime   Int?
  submittedAt DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@map("daily_challenge_submissions")
}
